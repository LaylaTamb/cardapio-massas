# Copie este arquivo para ".env" e preencha com os seus valores.
# O ".env" fica fora do Git (veja .gitignore).
#
# ATENCAO: o Vite injeta qualquer variavel VITE_* dentro do bundle JavaScript
# que roda no navegador. Ou seja, o token abaixo fica VISIVEL para quem abrir o
# app. Isso so e aceitavel porque este projeto roda APENAS localmente
# (npm run dev). NUNCA faca deploy/hospedagem publica deste app.

# Personal Access Token do GitHub.
# - Token classico: escopo "repo".
# - Fine-grained: acesso ao repositorio alvo + permissao "Contents: Read and write".
VITE_GITHUB_TOKEN=ghp_cole_seu_token_aqui

# Dono do repositorio (usuario ou organizacao)
VITE_GITHUB_OWNER=seu-usuario

# Nome do repositorio onde o pedidos.json vive
VITE_GITHUB_REPO=seu-repositorio

# Branch alvo dos commits (padrao: main)
VITE_GITHUB_BRANCH=main

# Caminho do arquivo dentro do repositorio (padrao: pedidos.json)
VITE_GITHUB_PATH=pedidos.json
